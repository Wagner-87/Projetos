<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Contratante"
             Title="Resumo da Reserva"
             BackgroundColor="#F9F8F6">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <!-- Cabeçalho Elegante -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="PARADISE RESORT" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1E3D59" 
                       HorizontalOptions="Center" />
                <Label Text="Detalhes da sua estadia" 
                       FontSize="14" 
                       TextColor="#C5A880" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Card de Resumo -->
            <Border BackgroundColor="White" 
                   Stroke="#E0DCD0" 
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 12" 
                   Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Resumo do Pedido" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1E3D59" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0DCD0" Margin="0,5" />

                    <!-- Informações da Reserva -->
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="lblQuarto" FontSize="15" TextColor="#2C3E50" />
                        <Label x:Name="lblDatas" FontSize="15" TextColor="#2C3E50" />
                        <Label x:Name="lblHospedes" FontSize="15" TextColor="#2C3E50" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E0DCD0" Margin="0,5" />

                    <!-- Bloco de Valores, Desconto e Economia -->
                    <Border BackgroundColor="White" 
                            Stroke="#E0DCD0" 
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" 
                            Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">

                            <!-- Valor sem desconto (fica riscado se houver cupom) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Valor Original:" TextColor="#7F8C8D" FontSize="14" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="lblValorBruto" Text="R$ 0,00" TextColor="#7F8C8D" FontSize="14" TextDecorations="Strikethrough" VerticalOptions="Center" />
                            </Grid>

                            <!-- Valor da Economia (visível apenas com cupom válido) -->
                            <Grid ColumnDefinitions="*, Auto" x:Name="layoutEconomia" IsVisible="false">
                                <Label Grid.Column="0" Text="Você economiza:" TextColor="#27AE60" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="lblEconomia" Text="R$ 0,00" TextColor="#27AE60" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E0DCD0" Margin="0,2" />

                            <!-- Valor Total em Destaque -->
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,10,0,0">
                                <Label Text="VALOR TOTAL DA ESTADIA" FontSize="12" FontAttributes="Bold" TextColor="#C5A880" HorizontalOptions="Center" />
                                <Label x:Name="lblValorTotal" FontSize="26" FontAttributes="Bold" TextColor="#1E3D59" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Botão de Voltar -->
            <Button Text="Voltar / Alterar Dados" 
                    Clicked="Button_Clicked" 
                    BackgroundColor="#1E3D59" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontAttributes="Bold" 
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>