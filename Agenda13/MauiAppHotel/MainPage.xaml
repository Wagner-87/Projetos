<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.MainPage"
             Title="Reserva - Paradise Resort"
             BackgroundColor="#F9F8F6">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <!-- Cabeçalho Elegante -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="PARADISE RESORT" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1E3D59" 
                       HorizontalOptions="Center" />
                <Label Text="Experiências inesquecíveis à beira-mar" 
                       FontSize="14" 
                       TextColor="#C5A880" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Card de Seleção -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0DCD0" 
                   CornerRadius="12" 
                   Padding="20" 
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">
                    <Label Text="Escolha a sua Acomodação" FontSize="16" FontAttributes="Bold" TextColor="#1E3D59" />
                    <Picker x:Name="pck_quarto" 
                            Title="Selecione uma suíte"
                            ItemDisplayBinding="{Binding Descricao}"
                            TextColor="#2C3E50" 
                            TitleColor="#8C9B9D" />

                    <Label Text="Data de Check-in" FontSize="14" TextColor="#2C3E50" />
                    <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy" TextColor="#1E3D59" />

                    <Label Text="Data de Check-out" FontSize="14" TextColor="#2C3E50" />
                    <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" TextColor="#1E3D59" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0DCD0" Margin="0,5" />

                    <HorizontalStackLayout Spacing="15">
                        <Label Text="Adultos:" VerticalOptions="Center" TextColor="#2C3E50" />
                        <Stepper x:Name="stp_adultos" Minimum="1" Maximum="10" Increment="1" />
                        <Label Text="{Binding Source={x:Reference stp_adultos}, Path=Value}" VerticalOptions="Center" FontAttributes="Bold" TextColor="#1E3D59" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="15">
                        <Label Text="Crianças:" VerticalOptions="Center" TextColor="#2C3E50" />
                        <Stepper x:Name="stp_criancas" Minimum="0" Maximum="10" Increment="1" />
                        <Label Text="{Binding Source={x:Reference stp_criancas}, Path=Value}" VerticalOptions="Center" FontAttributes="Bold" TextColor="#1E3D59" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Botões de Ação com Estilo Luxo -->
            <Button Text="Avançar para Reserva" 
                    Clicked="Button_Clicked" 
                    BackgroundColor="#1E3D59" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontAttributes="Bold" 
                    HeightRequest="50" />

            <Button Text="Sobre" 
                    Clicked="BtnSobre_Clicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#1E3D59" 
                    BorderColor="#1E3D59" 
                    BorderWidth="1"
                    CornerRadius="8" 
                    HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>