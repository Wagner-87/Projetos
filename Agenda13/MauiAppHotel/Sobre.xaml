<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Sobre"
             Title="Sobre o Resort"
             BackgroundColor="#F9F8F6">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <!-- Cabeçalho Elegante -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="PARADISE RESORT" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1E3D59" 
                       HorizontalOptions="Center" />
                <Label Text="Informações do Sistema" 
                       FontSize="14" 
                       TextColor="#C5A880" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Card de Conteúdo -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0DCD0" 
                   CornerRadius="12" 
                   Padding="20" 
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">
                    <Label Text="Sobre o Aplicativo" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1E3D59" />

                    <Label Text="Aplicativo desenvolvido para gerenciamento de reservas de hotel, cálculo automatizado de diárias e controlo de hóspedes com total sofisticação." 
                           FontSize="14" 
                           TextColor="#2C3E50" 
                           HorizontalTextAlignment="Start" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0DCD0" Margin="0,5" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Desenvolvedor: Wagner de Oliveira" FontSize="14" FontAttributes="Bold" TextColor="#1E3D59" />
                        <Label Text="Curso: Técnico em Desenvolvimento de Sistemas" FontSize="13" TextColor="#2C3E50" />
                        <Label Text="Ano: 2026" FontSize="13" TextColor="#C5A880" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Botão de Voltar com Estilo Coordenado -->
            <Button Text="Voltar" 
                    Clicked="Button_Clicked" 
                    BackgroundColor="#1E3D59" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontAttributes="Bold" 
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>